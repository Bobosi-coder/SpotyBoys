FROM python:3.9-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi uvicorn pydantic python-multipart httpx requests numpy scipy

COPY src/ /app/src/

ENV PYTHONPATH=/app
EXPOSE 8002

CMD ["uvicorn", "src.serving.triton_client:app", "--host", "0.0.0.0", "--port", "8002"]
