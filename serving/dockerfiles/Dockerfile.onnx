FROM python:3.10-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ /app/src/
COPY models/ /app/models/
ENV PYTHONPATH=/app/src
ENV ONNX_MODEL_PATH=/app/models/gru_ranker.onnx
EXPOSE 8001
CMD ["uvicorn", "onnx_api:app", "--host", "0.0.0.0", "--port", "8001", "--app-dir", "/app/src"]
