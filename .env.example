# SpotyBoys service VM environment.
# Copy to `.env` on each VM and fill in the secrets / public IPs.

# ---------------------------------------------------------------------------
# Object storage / S3-compatible Chameleon endpoint
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
AWS_ENDPOINT_URL=https://chi.tacc.chameleoncloud.org:7480
S3_ENDPOINT=https://chi.tacc.chameleoncloud.org:7480
S3_NO_VERIFY_SSL=true
ARTIFACT_BUCKET=proj23-mlflow-artifacts
BUCKET_NAME=proj23-mlflow-artifacts

# ---------------------------------------------------------------------------
# Public service URL
# ---------------------------------------------------------------------------
# Browser-visible URL for the service VM nginx entrypoint. Navidrome uses this
# for logout redirects, so do not leave this as localhost on the VM.
SPOTIBOYS_PUBLIC_BASE_URL=http://<service-vm-public-ip>:8089

# Optional. Empty means admin endpoints accept an authenticated SpotyBoys session.
SPOTIBOYS_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Airflow orchestration
# ---------------------------------------------------------------------------
# Used by recommendation-api / delta-export-worker to trigger the service_vm
# Airflow API from containers in the main docker-compose.yml.
AIRFLOW_BASE_URL=http://host.docker.internal:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=spotyboys-secret-2026
AIRFLOW_FERNET_KEY=
# Airflow's official image has an `airflow` user at UID 50000. Keep this value
# and chown service_vm/airflow/logs to 50000:0 on the service VM.
AIRFLOW_UID=50000

# service_vm/docker-compose.yaml uses one Postgres database for both MLflow and
# Airflow metadata tables.
SERVICE_VM_DB_USER=user
SERVICE_VM_DB_PASSWORD=password
SERVICE_VM_DB_NAME=mlflowdb

# Used by service_vm/docker-compose.yaml to configure Airflow's SSH connection
# to the GPU training VM. The key file path is inside the Airflow container.
GPU_VM_HOST=<gpu-vm-private-or-public-ip>
GPU_VM_USER=cc
GPU_VM_SSH_KEY_PATH=/home/cc/.ssh/airflow_gpu_key
AIRFLOW_CONN_GPU_VM_SSH=ssh://cc@<gpu-vm-private-or-public-ip>:22?key_file=%2Fopt%2Fairflow%2Fssh%2Fairflow_gpu_key&no_host_key_check=true

# ---------------------------------------------------------------------------
# MLflow on the service VM
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://<service-vm-public-ip>:8000
MLFLOW_S3_ENDPOINT_URL=https://chi.tacc.chameleoncloud.org:7480

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
SPOTIBOYS_RECOMMENDATION_IMAGE=spotiboys-vm1-recommendation-runtime:latest
SPOTIBOYS_REQUIRE_FULL_ML_PIPELINE=true
SPOTIBOYS_RETRAIN_THRESHOLD=1000
SPOTIBOYS_DELTA_INTERVAL_SECONDS=86400

# Catalog sync / Navidrome metadata sync. Defaults are fine for normal VM runs.
SPOTIBOYS_CATALOG_PROGRESS_EVERY=500
SPOTIBOYS_CATALOG_SYNC_LIMIT=0
SPOTIBOYS_REFRESH_CATALOG_METADATA=false
SPOTIBOYS_NAVIDROME_DB_WAIT_SECONDS=300
SPOTIBOYS_NAVIDROME_SCAN_WAIT_SECONDS=1800
SPOTIBOYS_NAVIDROME_SCAN_READY_RATIO=0.9
