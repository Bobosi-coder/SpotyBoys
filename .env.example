ITEM2VEC_RELEASE_PREFIX=processed/item2vec
RETRIEVER_RELEASE_PREFIX=features/retriever
RANKER_RELEASE_PREFIX=datasets/ranker
RELEASE_MANIFEST_PREFIX=manifests/releases
DATASET_VERSION=
FEATURE_VERSION=
