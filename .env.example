MOCK_ENABLE_RETRIEVER=false
MOCK_ENABLE_RANKER=false

MODEL_CHECKPOINT_PATH=artifacts/models/Cnn14_mAP=0.431.pth
EMBEDDINGS_OUTPUT_DIR=artifacts/embeddings

# Training data quality gate
# Set SPOTIBOYS_QG_ENABLED=false to bypass all checks during demo or emergency.
# Defaults below are intentionally low for demo; raise for production.
SPOTIBOYS_QG_ENABLED=true
SPOTIBOYS_QG_SESSION_TRACKS_MIN=5
SPOTIBOYS_QG_UNIQUE_USERS_MIN=2
SPOTIBOYS_QG_UNIQUE_TRACKS_MIN=3
SPOTIBOYS_QG_NULL_RATE_MAX=0.0
SPOTIBOYS_QG_POSITIVE_LABEL_RATE_MIN=0.01
SPOTIBOYS_QG_SKIP_LABEL_RATE_MAX=0.99
SPOTIBOYS_QG_PLAYRATIO_OOR_MAX=0.0
SPOTIBOYS_QG_DUPLICATE_RATE_WARN=0.50
