{
  "title": "SpotyBoys — Data Quality",
  "uid": "spotiboys-dq",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "tags": ["spotiboys", "data-quality"],
  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "① Ingestion Quality Gate",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## ① Ingestion Quality Gate\nTracks from Navidrome (external source) that could not be mapped to the 30Music catalog during delta-export-worker sync. Logged per sync cycle (every 24 h)."
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Total Rejections (24 h)",
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.ingestion_rejections WHERE created_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "piechart",
      "title": "Rejections by Source",
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": { "pieType": "pie", "legendDisplayMode": "table" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT source AS metric, COUNT(*) AS value FROM app.ingestion_rejections WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY source",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Rejection Count Over Time",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, source, COUNT(*) AS rejections FROM app.ingestion_rejections WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "text",
      "title": "② Live Inference Data Quality & Drift",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "Behavioral signals from production playback events. Skip/completion rates computed from finalized events (`playratio IS NOT NULL`)."
      }
    },

    {
      "id": 11,
      "type": "stat",
      "title": "Skip Rate (24 h)",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.35 },
              { "color": "red", "value": 0.50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE event_type = 'skip')::numeric / NULLIF(COUNT(*), 0), 4) AS value FROM app.playback_events WHERE playratio IS NOT NULL AND created_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Completion Rate (24 h)",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.30 },
              { "color": "green", "value": 0.50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE event_type = 'complete')::numeric / NULLIF(COUNT(*), 0), 4) AS value FROM app.playback_events WHERE playratio IS NOT NULL AND created_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
      "type": "stat",
      "title": "Model Status",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Healthy" },
                "1": { "text": "Degraded" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT CASE WHEN degraded THEN 1 ELSE 0 END AS value FROM app.model_status WHERE id = 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 14,
      "type": "stat",
      "title": "Active Users (24 h)",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(DISTINCT user_int_id) AS value FROM app.playback_events WHERE created_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Skip Rate / Completion Rate Over Time (hourly)",
      "gridPos": { "x": 0, "y": 14, "w": 14, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, ROUND(COUNT(*) FILTER (WHERE event_type = 'skip')::numeric / NULLIF(COUNT(*), 0), 4) AS \"skip_rate\", ROUND(COUNT(*) FILTER (WHERE event_type = 'complete')::numeric / NULLIF(COUNT(*), 0), 4) AS \"completion_rate\" FROM app.playback_events WHERE playratio IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Playback Event Volume Over Time (hourly)",
      "gridPos": { "x": 14, "y": 14, "w": 10, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS playback_events FROM app.playback_events WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 20,
      "type": "text",
      "title": "③ Training Data Quality Gate",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "Delta export history and session accumulation toward the next retraining trigger (threshold: 1,000 sessions)."
      }
    },

    {
      "id": 21,
      "type": "stat",
      "title": "Total Sessions",
      "gridPos": { "x": 0, "y": 23, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.rec_sessions",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 22,
      "type": "stat",
      "title": "Sessions Since Last Export",
      "gridPos": { "x": 4, "y": 23, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 900 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.rec_sessions WHERE session_int_id > COALESCE((SELECT session_int_id_watermark FROM app.delta_checkpoint ORDER BY id DESC LIMIT 1), 0)",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 23,
      "type": "stat",
      "title": "Delta Exports Completed",
      "gridPos": { "x": 8, "y": 23, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.delta_checkpoint",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 24,
      "type": "table",
      "title": "Delta Export History",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": { "sortBy": [{ "displayName": "exported_at", "desc": true }] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "exported_at" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT version AS delta_version, exported_at, session_int_id_watermark, rows_exported::text FROM app.delta_checkpoint ORDER BY id DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 25,
      "type": "timeseries",
      "title": "Session Accumulation Over Time",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS new_sessions FROM app.rec_sessions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 26,
      "type": "timeseries",
      "title": "Unique Users & Tracks Seen (hourly)",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(DISTINCT user_int_id) AS unique_users, COUNT(DISTINCT track_id) AS unique_tracks FROM app.playback_events WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    }

  ]
}
