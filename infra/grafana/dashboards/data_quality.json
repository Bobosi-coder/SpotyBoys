{
  "title": "SpotyBoys — Data Quality",
  "uid": "spotiboys-dq",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "tags": ["spotiboys", "data-quality"],
  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "① Ingestion Quality Gate",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## ① Ingestion Quality Gate\nEvents rejected at the API boundary before entering the database."
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Total Rejections (24 h)",
      "gridPos": { "x": 0, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.ingestion_rejections WHERE created_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "piechart",
      "title": "Rejections by Event Type",
      "gridPos": { "x": 4, "y": 2, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": { "pieType": "pie", "legendDisplayMode": "table" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT event_type AS metric, COUNT(*) AS value FROM app.ingestion_rejections WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY event_type",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Rejection Count Over Time",
      "gridPos": { "x": 10, "y": 2, "w": 14, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, event_type, COUNT(*) AS rejections FROM app.ingestion_rejections WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "text",
      "title": "② Live Inference Data Quality & Drift",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## ② Live Inference Data Quality & Drift\nBehavioral signals from production inference stream. Drift = deviation from rolling baseline."
      }
    },

    {
      "id": 11,
      "type": "stat",
      "title": "Skip Rate (24 h)",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.35 },
              { "color": "red", "value": 0.50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE event_type = 'skip')::numeric / NULLIF(COUNT(*),0), 4) AS value FROM app.playback_events WHERE occurred_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Completion Rate (24 h)",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.30 },
              { "color": "green", "value": 0.50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE event_type = 'complete')::numeric / NULLIF(COUNT(*),0), 4) AS value FROM app.playback_events WHERE occurred_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
      "type": "stat",
      "title": "Like Rate (24 h)",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.03 },
              { "color": "green", "value": 0.07 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE feedback_type = 'like')::numeric / NULLIF((SELECT COUNT(*) FROM app.recommendation_impressions WHERE created_at >= NOW() - INTERVAL '24 hours'),0), 4) AS value FROM app.feedback_events WHERE occurred_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 14,
      "type": "stat",
      "title": "Ingestion Rejection Rate (24 h)",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT ROUND(rejected::numeric / NULLIF(rejected + accepted, 0), 4) AS value FROM (SELECT (SELECT COUNT(*) FROM app.ingestion_rejections WHERE created_at >= NOW() - INTERVAL '24 hours') AS rejected, (SELECT COUNT(*) FROM app.playback_events WHERE occurred_at >= NOW() - INTERVAL '24 hours') + (SELECT COUNT(*) FROM app.feedback_events WHERE occurred_at >= NOW() - INTERVAL '24 hours') + (SELECT COUNT(*) FROM app.rendered_impressions WHERE received_at >= NOW() - INTERVAL '24 hours') AS accepted) t",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Skip Rate / Completion Rate Over Time (hourly)",
      "gridPos": { "x": 0, "y": 12, "w": 14, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', occurred_at) AS time, ROUND(COUNT(*) FILTER (WHERE event_type='skip')::numeric / NULLIF(COUNT(*),0), 4) AS \"skip_rate\", ROUND(COUNT(*) FILTER (WHERE event_type='complete')::numeric / NULLIF(COUNT(*),0), 4) AS \"completion_rate\" FROM app.playback_events WHERE $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Event Volume Over Time (hourly)",
      "gridPos": { "x": 14, "y": 12, "w": 10, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', occurred_at) AS time, 'playback' AS metric, COUNT(*) AS value FROM app.playback_events WHERE $__timeFilter(occurred_at) GROUP BY 1 UNION ALL SELECT date_trunc('hour', occurred_at), 'feedback', COUNT(*) FROM app.feedback_events WHERE $__timeFilter(occurred_at) GROUP BY 1 UNION ALL SELECT date_trunc('hour', created_at), 'impression', COUNT(*) FROM app.recommendation_impressions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 20,
      "type": "text",
      "title": "③ Training Data Quality Gate",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## ③ Training Data Quality Gate\nDelta export history and session accumulation toward the next retraining trigger (threshold: 1,000 sessions)."
      }
    },

    {
      "id": 21,
      "type": "stat",
      "title": "Total Sessions",
      "gridPos": { "x": 0, "y": 20, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.sessions",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 22,
      "type": "stat",
      "title": "Sessions Since Last Export",
      "gridPos": { "x": 4, "y": 20, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 900 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.sessions WHERE session_int_id > COALESCE((SELECT last_exported_session_int_id FROM app.delta_export_metadata ORDER BY recorded_at DESC LIMIT 1), 0)",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 23,
      "type": "stat",
      "title": "Successful Delta Exports",
      "gridPos": { "x": 8, "y": 20, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM app.delta_export_metadata WHERE status = 'success'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 24,
      "type": "table",
      "title": "Delta Export History",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "options": { "sortBy": [{ "displayName": "recorded_at", "desc": true }] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "status" },
            "properties": [{ "id": "custom.width", "value": 80 }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT delta_version, status, session_tracks_rows, recorded_at FROM app.delta_export_metadata ORDER BY recorded_at DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 25,
      "type": "timeseries",
      "title": "Session Accumulation Over Time",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS \"new_sessions\" FROM app.sessions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 26,
      "type": "timeseries",
      "title": "Unique Users & Tracks Seen (hourly)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "spotiboys-pg" },
          "rawSql": "SELECT date_trunc('hour', occurred_at) AS time, COUNT(DISTINCT user_id) AS \"unique_users\", COUNT(DISTINCT track_id) AS \"unique_tracks\" FROM app.playback_events WHERE $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ]
    }

  ]
}
