FROM python:3.9-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir fastapi uvicorn pydantic python-multipart httpx onnxruntime numpy scipy

COPY . /app/

ENV PYTHONPATH=/app
EXPOSE 8001

CMD ["uvicorn", "src.serving.onnx_api:app", "--host", "0.0.0.0", "--port", "8001"]
