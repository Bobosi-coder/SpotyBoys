# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env
songs embedding/.venv/

# ── Lock files (generated, not cross-platform) ────────────────────────────────
uv.lock

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Training artifacts (stored in S3, not git) ────────────────────────────────
# Model weights and embeddings
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.bin
artifacts/**/*.bin.vectors.npy
artifacts/**/*.npy
artifacts/**/*.pkl
artifacts/**/*.npz
# Data files produced by training pipeline
artifacts/**/*.csv
artifacts/**/*.parquet
artifacts/**/*.json
artifacts/**/*.tar.gz
artifacts/**/*.tar
artifacts/audio_cache/
# Keep directory structure markers
!artifacts/.gitkeep
!artifacts/**/.gitkeep
!artifacts/README.md

# ── Top-level training output directories ────────────────────────────────────
/item2vec/
/ranker/
/retriever/
/real_service/
/models/
/audio_cache/

# ── Build logs and process files ─────────────────────────────────────────────
logs/
*.log
*.pid
.ranker_build.pid
.demo_gateway.pid
.demo_gateway.log
.local/

# ── Raw / large data ─────────────────────────────────────────────────────────
/data/
data/raw/30music/*
!data/raw/30music/.gitkeep
data/audio_samples/*
!data/audio_samples/.gitkeep

# ── Secrets ───────────────────────────────────────────────────────────────────
.env.local
.env.*.local
*.pem
*.key

# ── Test / coverage output ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
