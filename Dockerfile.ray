FROM rayproject/ray:2.9.0-py39-cpu

WORKDIR /app

USER root
RUN apt-get update && apt-get install -y ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
USER ray

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir fastapi uvicorn pydantic python-multipart httpx scipy numpy

COPY src/ /app/src/

ENV PYTHONPATH=/app
EXPOSE 8000

CMD ["serve", "run", "src.serving.ray_serve_api:pann_app", "--host", "0.0.0.0", "--port", "8000"]
